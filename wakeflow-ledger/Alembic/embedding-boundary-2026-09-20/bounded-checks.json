{
  "cwd": "Alembic",
  "node": "22.23.2",
  "checks": [
    {
      "label": "bounded-unit",
      "command": [
        "npm",
        "run",
        "test:unit",
        "--",
        "--maxWorkers=4"
      ],
      "exitCode": 1,
      "log": "bounded-unit.log"
    },
    {
      "label": "bounded-integration",
      "command": [
        "npm",
        "run",
        "test:integration",
        "--",
        "--maxWorkers=4"
      ],
      "exitCode": 1,
      "log": "bounded-integration.log"
    },
    {
      "label": "verified-coverage",
      "command": [
        "npm",
        "run",
        "test:coverage"
      ],
      "exitCode": 0,
      "log": "verified-coverage.log"
    },
    {
      "label": "verified-drift",
      "command": [
        "npm",
        "run",
        "check:shared-asset-drift"
      ],
      "exitCode": 0,
      "log": "verified-drift.log"
    },
    {
      "label": "verified-retired",
      "command": [
        "npm",
        "run",
        "lint:retired-symbols"
      ],
      "exitCode": 0,
      "log": "verified-retired.log"
    },
    {
      "label": "verified-rings",
      "command": [
        "npm",
        "run",
        "lint:ring-direction"
      ],
      "exitCode": 0,
      "log": "verified-rings.log"
    }
  ]
}
