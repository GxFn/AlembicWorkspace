+  const pluginCoherence = pluginSections.filter((s) => !perHostSections.has(s.name));
+  const mainNames = mainCoherence.map((s) => s.name).join(',');
+  const pluginNames = pluginCoherence.map((s) => s.name).join(',');
   if (mainNames !== pluginNames) {
