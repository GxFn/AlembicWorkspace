    "Alembic/",
    "AlembicCore/",
    "AlembicAgent/",
    "AlembicDashboard/",
    "AlembicPlugin/"
  ],
  "repositoryRoles": {
    "Alembic": "Alembic work window",
    "AlembicCore": "AlembicCore work window",
    "AlembicAgent": "AlembicAgent work window",
    "AlembicDashboard": "AlembicDashboard work window",
    "AlembicPlugin": "AlembicPlugin work window",
    "Design": "Internal requirement and outcome redesign workspace",
    "Test": "Internal test coordination workspace"
  },
  "repositories": [
    {
      "windowName": "Alembic",
      "path": "Alembic",
      "mode": "external",
      "role": "Alembic work window",
      "managedAgents": true
    },
    {
      "windowName": "AlembicCore",
      "path": "AlembicCore",
      "mode": "external",
      "role": "AlembicCore work window",
      "managedAgents": true
    },
    {
      "windowName": "AlembicAgent",
      "path": "AlembicAgent",
      "mode": "external",
      "role": "AlembicAgent work window",
      "managedAgents": true
    },
    {
      "windowName": "AlembicDashboard",
      "path": "AlembicDashboard",
      "mode": "external",
      "role": "AlembicDashboard work window",
      "managedAgents": true
    },
    {
      "windowName": "AlembicPlugin",
      "path": "AlembicPlugin",
      "mode": "external",
      "role": "AlembicPlugin work window",
      "managedAgents": true
    },
    {
      "windowName": "Design",
      "path": "Design",
      "mode": "internal",
      "role": "Internal requirement and outcome redesign workspace",
      "managedAgents": false
    },
    {
      "windowName": "Test",
      "path": "Test",
      "mode": "internal",
      "role": "Internal test coordination workspace",
      "managedAgents": false
    }
  ],
  "hosts": {
    "codex": {},
    "claude-code": {
      "tmuxSession": "alembic",
      "claudeArgs": [
        "--effort",
        "max"
      ],
      "permissionMode": "bypassPermissions"
    }
  }
}
